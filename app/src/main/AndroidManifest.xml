<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Foreground service so the meter keeps sampling while the app is backgrounded. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- API 33+ requires runtime consent before any notification (our icon) shows. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-arm the meter after reboot if the user had it enabled. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Read-only connection type (Wi-Fi vs mobile) for the notification label.
         This is NOT android.permission.INTERNET — it grants no network access,
         so the "data never leaves the device" guarantee is unchanged. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Read-only Wi-Fi RSSI for the signal-strength % in the panel line. Normal
         (auto-granted) permission; like above, it grants no network access. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Floating speed bubble (user-granted in system settings; off by default). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Optional convenience: lets us prompt the user to whitelist us from Doze. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- NOTE: deliberately NO android.permission.INTERNET. TrafficStats reads
         kernel counters and needs no network access. Shipping without INTERNET
         is a verifiable privacy guarantee: the app cannot phone home. -->

    <application
        android:name=".NetSpeedApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetSpeedIndicator"
        tools:targetApi="35">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NetSpeedIndicator">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SpeedMeterService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Android 14+ demands a human-readable justification for specialUse.
                 None of the predefined FGS types (location, mediaPlayback, sync…)
                 fit a passive network-speed indicator, hence specialUse. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Live network speed indicator drawn into the status-bar notification icon, refreshed once per second from TrafficStats." />
        </service>

        <!-- Home-screen widgets. Each renders via the shared WidgetPainters and is
             refreshed 1/sec by the service while the screen is on. -->
        <receiver
            android:name=".widget.HeroWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_hero_info" />
        </receiver>
        <receiver
            android:name=".widget.DialWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_dial_info" />
        </receiver>
        <receiver
            android:name=".widget.RingsWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_rings_info" />
        </receiver>
        <receiver
            android:name=".widget.PillWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_pill_info" />
        </receiver>
        <receiver
            android:name=".widget.WeatherWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_weather_info" />
        </receiver>

        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- HTC / some OEM variant of boot broadcast. -->
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
