<?xml version="1.0" encoding="utf-8"?>
<!-- Full-bleed gradient notification body: the gradient IS the card (no inner
     card-within-a-card). The background is a per-second rendered Bitmap so the
     gradient FLOWS (gemini animation); header, number, sparkline and actions all
     sit on it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/notif_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/notif_strip_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notif_strip_label"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/notif_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="0.0 MB/s"
                android:textColor="#FFFFFFFF"
                android:textSize="26sp" />

            <ImageView
                android:id="@+id/notif_sparkline"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:contentDescription="@string/notif_strip_label"
                android:scaleType="fitXY" />
        </LinearLayout>

        <!-- Action chips, on the gradient. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/action_pause"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/notif_action_pause"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/action_style"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/notif_action_style"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/action_hide"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/notif_action_hide"
                android:textColor="#FFFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
